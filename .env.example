# CESAL Room Monitor Telegram configuration
# Copy this file to .env and edit the values.

# CESAL search settings
CESAL_END_DATE=31/12/2026
CESAL_MIN_WAIT_SECONDS=360
CESAL_MAX_WAIT_SECONDS=720
CESAL_PAGE_WAIT_SECONDS=5
CESAL_EDGE_PROFILE_DIR=C:\cesal_edge_profile
CESAL_HEADLESS=false

# Telegram settings
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=
TELEGRAM_AUTO_DISCOVER_CHAT_ID=true
TELEGRAM_STARTUP_TEST=false

# Notification policy
SEND_FIRST_SUCCESSFUL_CHECK=true
NOTIFY_ONLY_ON_CHANGE=true
